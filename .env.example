# ============================================================
# Soleful Soaks! — konfigurasi frontend
# Salin menjadi `.env.local`. JANGAN commit file .env asli.
# Semua variabel VITE_* akan terlihat di browser -> hanya isi
# nilai publik (URL & anon key). JANGAN taruh service_role key
# atau kredensial Google di sini.
# ============================================================

# Mode data:
#   local    = demo lokal, data tersimpan di browser (localStorage + IndexedDB)
#   supabase = gunakan Supabase (belum diaktifkan, lihat docs/SUPABASE.md)
VITE_DATA_MODE=local

# Diisi saat migrasi ke Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL Web App Google Apps Script untuk upload foto (lihat docs/GOOGLE_DRIVE.md).
# Kosongkan bila belum dikonfigurasi -> foto disimpan lokal (mode demo).
VITE_PHOTO_UPLOAD_ENDPOINT=
